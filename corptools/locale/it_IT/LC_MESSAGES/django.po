#: corptools/templates/corptools/wallet_export_list.html:23
#, python-format
msgid ""
"\n"
"                Exports all NPC wallet journal entries older than %(days)s days to\n"
"                Django fixture files (one chunk per run, watermarked to avoid re-exporting).\n"
"                "
msgstr ""
"\n"
"                Esporta tutte le voci NPC del registro del portafoglio più vecchie di %(days)s giorni in\n"
"                file fixture di Django (un blocco per esecuzione, con un segnalibro per evitare di riesportarle).\n"
"                "

#: corptools/templates/corptools/wallet_export_list.html:29
#, python-format
msgid ""
"\n"
"                %(count)s NPC ref_types are tracked for export and purge.\n"
"                "
msgstr ""
"\n"
"                %(count)s ref_type NPC vengono tracciati per l'esportazione e l'eliminazione.\n"
"                "

#: corptools/templates/corptools/wallet_export_list.html:35
msgid "Queue Fixture Export"
msgstr "Metti in coda l'esportazione delle fixture"

#: corptools/templates/corptools/wallet_export_list.html:47
msgid "Purge NPC Wallet Data"
msgstr "Elimina i dati NPC del portafoglio"

#: corptools/templates/corptools/wallet_export_list.html:50
#, python-format
msgid ""
"\n"
"                Deletes all NPC wallet journal entries older than %(days)s days from the database.\n"
"                Run the fixture export first to archive data before purging.\n"
"                "
msgstr ""
"\n"
"                Elimina dal database tutte le voci NPC del registro del portafoglio più vecchie di %(days)s giorni.\n"
"                Prima di eliminarle, esegui l'esportazione delle fixture per archiviare i dati.\n"
"                "

#: corptools/templates/corptools/wallet_export_list.html:56
#, python-format
msgid ""
"\n"
"                Purges the same %(count)s NPC ref_types tracked for export.\n"
"                "
msgstr ""
"\n"
"                Elimina gli stessi %(count)s ref_type NPC tracciati per l'esportazione.\n"
"                "

