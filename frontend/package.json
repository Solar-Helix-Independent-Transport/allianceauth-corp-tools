{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "react-slider": {
      "react": "$react"
    },
    "i18next-scanner-typescript": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "dev": "vite",
    "tsc": "tsc",
    "build": "tsc && vite build && ./copy-assets.sh",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "buildApiTypes": "npx openapi-typescript ./openapi.json -o ./src/api/CtApi.d.ts",
    "buildTranslations": "npx i18next-scanner --config i18next-scanner.config.cjs && ./copy-langs.sh"
  },
  "dependencies": {
    "@nivo/bar": "^0.99.0",
    "@nivo/chord": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/radar": "^0.99.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.12.0",
    "@types/js-cookie": "^3.0.6",
    "@types/react-timeago": "^4.1.7",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.12.0",
    "bootstrap": "^5.3.3",
    "csv-stringify": "^6.5.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.0.3",
    "i18next-http-backend": "^4.0.0",
    "javascript-time-ago": "^2.5.10",
    "js-cookie": "^3.0.5",
    "nuqs": "^2.4.3",
    "openapi-fetch": "^0.17.0",
    "rc-slider": "^11.1.8",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.9",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "react-select": "^5.8.0",
    "react-slider": "^2.0.6",
    "react-time-ago": "^7.3.3",
    "react-timeago": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "i18next-scanner": "^4.6.0",
    "i18next-scanner-typescript": "^1.2.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
